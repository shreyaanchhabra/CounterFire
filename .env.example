XAI_API_KEY=
# Use scripts/smoke_test.py --list-models after adding the key.
GROK_MODEL=
GROK_FAST_MODEL=
DEMO_MODE=hybrid
GROK_TIMEOUT_SECONDS=8
FIREBREAK_CACHE_DIR=cache

# Official Grok Bot routine trigger. Independent of XAI_API_KEY and gbot CLI.
# Copy these from the selected routine's Webhook settings. Never commit them.
GROKBOTS_WEBHOOK_URL=
GROKBOTS_WEBHOOK_KEY=

# Full native society: one webhook-only routine per community.
GROKBOTS_GROUP_0_URL=
GROKBOTS_GROUP_0_KEY=
GROKBOTS_GROUP_1_URL=
GROKBOTS_GROUP_1_KEY=
GROKBOTS_GROUP_2_URL=
GROKBOTS_GROUP_2_KEY=
GROKBOTS_GROUP_3_URL=
GROKBOTS_GROUP_3_KEY=
GROKBOTS_GROUP_4_URL=
GROKBOTS_GROUP_4_KEY=
GROKBOTS_GROUP_5_URL=
GROKBOTS_GROUP_5_KEY=
# Public HTTPS origin for the callback-only service on localhost:8766.
# Update every native routine's exact hostname allowlist when changing it.
GROKBOTS_CALLBACK_BASE_URL=
GROKBOTS_TASK_TIMEOUT_SECONDS=300
