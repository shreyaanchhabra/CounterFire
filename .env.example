# Copy this file to .env and fill it in. Never commit .env.
GEMINI_API_KEY=
# Leave blank to auto-pick the newest Flash model your key can use (scripts/smoke_test.py prints the list).
# Newest isn't always best: on Oct 24 2026 gemini-3.8-flash was overloaded (40s calls) and gemini-3.5-flash took ~1s.
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated backups, tried in order when a model is overloaded (503) or out of quota (429).
# The free tier allows only 20 requests per day per model, so a chain matters.
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional stronger model for the Judge and the eval. Blank = same as GEMINI_MODEL.
GEMINI_JUDGE_MODEL=
XAI_API_KEY=
GROK_MODEL=
GROK_FAST_MODEL=
VOISKEY_API_KEY=
VOISKEY_BASE_URL=
# replay | live | hybrid
DEMO_MODE=hybrid
